        "CoreHaptics.framework",
        "AudioToolbox.framework",
        "AVFoundation.framework",
        "CoreGraphics.framework",
        "CoreImage.framework",
        "CoreLocation.framework",
        "CoreMedia.framework",
        "CoreMotion.framework",
        "CoreTelephony.framework",
        "CoreText.framework",
        "ImageIO.framework",
        "MapKit.framework",
        "QuartzCore.framework",
        "StoreKit.framework",
        "UIKit.framework",
        "DeviceCheck.framework"
